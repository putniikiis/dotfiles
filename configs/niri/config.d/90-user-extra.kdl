// ─────────────────────────────────────────────────────────────────────────────
// Personal / machine overrides
// Regenerated by ./install.sh (detects DRM outputs for THIS device).
// Manual edits are fine — re-run: ./install.sh --fix-outputs
// ─────────────────────────────────────────────────────────────────────────────

// Placeholder until install.sh runs. Safe defaults; no hardcoded vendor modes.
output "eDP-1" {
    scale 1
    transform "normal"
    position x=0 y=0
    focus-at-startup
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle,compose:rctrl,ctrl:nocaps"
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
}

cursor {
    xcursor-theme "capitaine-cursors-light"
    xcursor-size 24
    hide-when-typing
}

binds {
    Ctrl+Alt+Delete allow-inhibiting=false { spawn "inir" "session" "toggle"; }
    Mod+L allow-when-locked=true { spawn "inir" "lock" "activate"; }
    Mod+Ctrl+P { spawn "inir" "settingsNav" "page" "28"; }
}
